rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'merlinfiverr0@gmail.com';
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'merlinfiverr0@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Entity Validation Blueprints
    function isValidProject(data) {
      return data.keys().hasAll([
        'title', 'cardTitle', 'slug', 'category', 'categorySubtitle', 'client', 'year',
        'shortDescription', 'overview', 'challenge', 'solution',
        'technologies', 'features', 'screenshotUrl', 'liveUrl',
        'featured', 'order', 'status', 'date', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'title', 'cardTitle', 'slug', 'category', 'categorySubtitle', 'client', 'year',
        'shortDescription', 'overview', 'challenge', 'solution',
        'technologies', 'features', 'screenshotUrl', 'liveUrl',
        'featured', 'order', 'status', 'date', 'updatedAt'
      ]) &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
      data.cardTitle is string && data.cardTitle.size() >= 1 && data.cardTitle.size() <= 120 &&
      data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 100 && data.slug.matches('^[a-z0-9\\-]+$') &&
      data.category is string && data.category in ['Mobile App', 'Web Platform', 'Streaming', 'UI/UX', 'Websites'] &&
      data.categorySubtitle is string && data.categorySubtitle.size() >= 2 && data.categorySubtitle.size() <= 120 &&
      data.client is string && data.client.size() >= 1 && data.client.size() <= 100 &&
      data.year is string && data.year.size() >= 4 && data.year.size() <= 10 &&
      data.shortDescription is string && data.shortDescription.size() >= 10 && data.shortDescription.size() <= 400 &&
      data.overview is string && data.overview.size() >= 20 && data.overview.size() <= 2500 &&
      data.challenge is string && data.challenge.size() >= 20 && data.challenge.size() <= 2500 &&
      data.solution is string && data.solution.size() >= 20 && data.solution.size() <= 2500 &&
      data.technologies is list && data.technologies.size() >= 1 && data.technologies.size() <= 10 && data.technologies[0] is string && data.technologies[0].size() <= 60 &&
      data.features is list && data.features.size() >= 1 && data.features.size() <= 10 && data.features[0] is string && data.features[0].size() <= 200 &&
      data.screenshotUrl is string && data.screenshotUrl.size() >= 1 && data.screenshotUrl.size() <= 500 &&
      data.liveUrl is string && data.liveUrl.size() >= 1 && data.liveUrl.size() <= 500 &&
      data.featured is bool &&
      data.order is number &&
      data.status is string && data.status in ['Published', 'In Progress', 'Planning', 'Draft'] &&
      data.date is string && data.date.size() >= 3 && data.date.size() <= 40 &&
      data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 40;
    }

    function isValidService(data) {
      return data.keys().hasAll([
        'number', 'title', 'description', 'deliverables', 'iconName', 'imageUrl', 'order', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'number', 'title', 'description', 'deliverables', 'iconName', 'imageUrl', 'order', 'updatedAt'
      ]) &&
      data.number is string && data.number.size() >= 2 && data.number.size() <= 4 &&
      data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
      data.description is string && data.description.size() >= 10 && data.description.size() <= 800 &&
      data.deliverables is list && data.deliverables.size() >= 1 && data.deliverables.size() <= 8 && data.deliverables[0] is string && data.deliverables[0].size() <= 140 &&
      data.iconName is string && data.iconName.size() >= 2 && data.iconName.size() <= 40 &&
      data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 300 &&
      data.order is number &&
      data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 40;
    }

    function isValidPricingTier(data) {
      return data.keys().hasAll([
        'name', 'price', 'subtitle', 'description', 'features', 'highlighted', 'deliveryTime', 'buttonText', 'order', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'name', 'price', 'subtitle', 'description', 'features', 'highlighted', 'deliveryTime', 'buttonText', 'order', 'updatedAt'
      ]) &&
      data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
      data.price is string && data.price.size() >= 2 && data.price.size() <= 60 &&
      data.subtitle is string && data.subtitle.size() >= 4 && data.subtitle.size() <= 160 &&
      data.description is string && data.description.size() >= 10 && data.description.size() <= 500 &&
      data.features is list && data.features.size() >= 1 && data.features.size() <= 20 && data.features[0] is string && data.features[0].size() <= 160 &&
      data.highlighted is bool &&
      data.deliveryTime is string && data.deliveryTime.size() >= 2 && data.deliveryTime.size() <= 80 &&
      data.buttonText is string && data.buttonText.size() >= 2 && data.buttonText.size() <= 60 &&
      data.order is number &&
      data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 40;
    }

    function isValidInquiry(data) {
      return data.keys().hasAll([
        'name', 'email', 'phone', 'packageInterest', 'message', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'name', 'email', 'phone', 'packageInterest', 'budget', 'message', 'createdAt'
      ]) &&
      data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
      data.email is string && data.email.size() >= 5 && data.email.size() <= 150 && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
      data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 40 &&
      data.packageInterest is string && data.packageInterest.size() >= 2 && data.packageInterest.size() <= 100 &&
      (!('budget' in data) || (data.budget is string && data.budget.size() <= 60)) &&
      data.message is string && data.message.size() >= 1 && data.message.size() <= 2000 &&
      data.createdAt is string && data.createdAt.size() >= 10 && data.createdAt.size() <= 40;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['email', 'createdAt']) &&
      data.keys().hasOnly(['email', 'createdAt']) &&
      data.email is string && data.email.size() >= 5 && data.email.size() <= 150 &&
      data.createdAt is string && data.createdAt.size() >= 10 && data.createdAt.size() <= 40;
    }

    // Connection health check endpoint (read-only)
    match /test/{docId} {
      allow get: if isValidId(docId);
      allow list, write: if false;
    }

    // Portfolio Projects Collection (Public read, admin-only write)
    match /projects/{projectId} {
      allow get, list: if true;
      allow create: if isVerifiedUser() && isValidId(projectId) && isValidProject(incoming()) && isAdmin();
      allow update: if isVerifiedUser() && isValidId(projectId) && isValidProject(incoming()) && isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'cardTitle', 'slug', 'category', 'categorySubtitle', 'client', 'year',
          'shortDescription', 'overview', 'challenge', 'solution',
          'technologies', 'features', 'screenshotUrl', 'liveUrl',
          'featured', 'order', 'status', 'date', 'updatedAt'
        ]);
      allow delete: if isVerifiedUser() && isValidId(projectId) && isAdmin();
    }

    // Agency Services Collection (Public read, admin-only write)
    match /services/{serviceId} {
      allow get, list: if true;
      allow create: if isVerifiedUser() && isValidId(serviceId) && isValidService(incoming()) && isAdmin();
      allow update: if isVerifiedUser() && isValidId(serviceId) && isValidService(incoming()) && isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'number', 'title', 'description', 'deliverables', 'iconName', 'imageUrl', 'order', 'updatedAt'
        ]);
      allow delete: if isVerifiedUser() && isValidId(serviceId) && isAdmin();
    }

    // Pricing Tiers Collection (Public read, admin-only write)
    match /pricing/{pricingId} {
      allow get, list: if true;
      allow create: if isVerifiedUser() && isValidId(pricingId) && isValidPricingTier(incoming()) && isAdmin();
      allow update: if isVerifiedUser() && isValidId(pricingId) && isValidPricingTier(incoming()) && isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'price', 'subtitle', 'description', 'features', 'highlighted', 'deliveryTime', 'buttonText', 'order', 'updatedAt'
        ]);
      allow delete: if isVerifiedUser() && isValidId(pricingId) && isAdmin();
    }

    // Contact Inquiries Collection (Public create, admin-only read & delete)
    match /inquiries/{inquiryId} {
      allow get, list: if isVerifiedUser() && isAdmin();
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming());
      allow update: if false;
      allow delete: if isVerifiedUser() && isValidId(inquiryId) && isAdmin();
    }

    // Administrators Registry
    match /admins/{adminId} {
      allow get: if isVerifiedUser() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if isVerifiedUser() && isAdmin();
      allow create: if isVerifiedUser() && isValidId(adminId) && isValidAdminRecord(incoming()) && isAdmin();
      allow update: if false;
      allow delete: if isVerifiedUser() && isValidId(adminId) && isAdmin();
    }
  }
}
